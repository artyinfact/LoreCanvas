{
  "name": "lorecanvas",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "harness": "node ./scripts/init.mjs",
    "harness:validate": "node ./scripts/init.mjs --validate-only",
    "harness:quick": "node ./scripts/init.mjs --no-install",
    "agent:status": "node ./scripts/agent-run.mjs status",
    "agent:next": "node ./scripts/agent-run.mjs next",
    "dev": "node ./scripts/dev-server.mjs",
    "build": "node ./scripts/run-with-modern-node.mjs ./node_modules/typescript/bin/tsc -b && node ./scripts/run-with-modern-node.mjs ./node_modules/vite/bin/vite.js build",
    "check-types": "node ./scripts/run-with-modern-node.mjs ./node_modules/typescript/bin/tsc -b --pretty false",
    "test": "node ./scripts/run-with-modern-node.mjs ./node_modules/vitest/vitest.mjs run",
    "preview": "node ./scripts/run-with-modern-node.mjs ./node_modules/vite/bin/vite.js preview --host 0.0.0.0"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "lucide-react": "^1.17.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
